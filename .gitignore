# ──────────────────────────────────────────────
# Terraform
# ──────────────────────────────────────────────

# Local .terraform directory (provider plugins, modules cache)
**/.terraform/

# Terraform lock file (commit this to version control)
# .terraform.lock.hcl

# State files — never commit state
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log
crash.log
crash.*.log

# Terraform variable files that may contain secrets
*.tfvars.json
# Uncomment below if tfvars contain secrets (use separate secret management instead)
# *.tfvars

# Override files (local developer overrides, not for sharing)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config file
.terraformrc
terraform.rc

# ──────────────────────────────────────────────
# SSH / Keys — never commit private keys
# ──────────────────────────────────────────────
ec2-key
*.pem
*.key
id_rsa
id_rsa*

# ──────────────────────────────────────────────
# OS
# ──────────────────────────────────────────────
.DS_Store
Thumbs.db
